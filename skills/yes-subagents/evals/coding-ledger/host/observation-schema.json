{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coding Ledger Eval Observations",
  "type": "object",
  "required": ["run_id", "package_id", "started_at", "pipelines", "token_ledger"],
  "properties": {
    "run_id": {"type": "string"},
    "package_id": {"const": "coding-ledger-v1"},
    "started_at": {"type": "string"},
    "finished_at": {"type": ["string", "null"]},
    "pipelines": {
      "type": "object",
      "required": ["thin", "thick"],
      "properties": {
        "thin": {"$ref": "#/$defs/pipeline"},
        "thick": {"$ref": "#/$defs/pipeline"}
      },
      "additionalProperties": false
    },
    "token_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/tokenEntry"}
    },
    "metrics": {
      "type": "object",
      "required": ["by_stage", "full_run_accounting"],
      "properties": {
        "by_stage": {
          "type": "array",
          "items": {"$ref": "#/$defs/stageMetrics"}
        },
        "full_run_accounting": {"$ref": "#/$defs/runAccounting"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "pipeline": {
      "type": "object",
      "required": ["validity", "stages", "business_verification", "process_findings", "judgment_observations"],
      "properties": {
        "validity": {
          "type": "object",
          "required": ["status", "evidence"],
          "properties": {
            "status": {"enum": ["VALID", "INVALID"]},
            "evidence": {"type": "array", "items": {"type": "string"}}
          }
        },
        "stages": {
          "type": "array",
          "items": {"$ref": "#/$defs/stage"}
        },
        "business_verification": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "process_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "judgment_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "session_id", "parent_session_id", "status", "inputs", "outputs", "dispatches"],
      "properties": {
        "id": {"enum": ["P-thin", "E-thin", "P-thick", "E-thick", "E-thick-M1", "E-thick-M2"]},
        "session_id": {"type": ["string", "null"]},
        "parent_session_id": {"type": ["string", "null"]},
        "status": {"enum": ["DONE", "BLOCKED", "FAILED", "INVALID"]},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "dispatches": {"type": "array", "items": {"$ref": "#/$defs/dispatch"}},
        "commits": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dispatch": {
      "type": "object",
      "required": ["session_id", "role", "task", "status"],
      "properties": {
        "session_id": {"type": ["string", "null"]},
        "role": {"type": "string"},
        "task": {"type": "string"},
        "boundary": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observation": {
      "type": "object",
      "required": ["question", "observation", "evidence"],
      "properties": {
        "question": {"type": "string"},
        "observation": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "tokenEntry": {
      "type": "object",
      "required": ["session_id", "stage", "role", "turns", "cache_miss_input_tokens", "cache_read_input_tokens", "output_tokens", "total_billable_tokens", "cost_usd"],
      "properties": {
        "session_id": {"type": "string"},
        "parent_session_id": {"type": ["string", "null"]},
        "stage": {"type": "string"},
        "role": {"type": "string"},
        "turns": {"type": ["integer", "null"], "minimum": 0},
        "cache_miss_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cache_read_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_billable_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "source": {"type": "string"}
      }
    },
    "stageMetrics": {
      "type": "object",
      "required": ["stage", "deliverable_type", "verified_deliverables", "total_billable_tokens", "total_cost_usd", "tpvd_k_tokens_per_vd", "cpvd_usd_per_vd", "cptk_usd_per_k_tokens"],
      "properties": {
        "stage": {"type": "string"},
        "deliverable_type": {"enum": ["plan", "implementation"]},
        "verified_deliverables": {"type": "integer", "minimum": 0},
        "total_billable_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "tpvd_k_tokens_per_vd": {"type": ["number", "null"], "minimum": 0},
        "cpvd_usd_per_vd": {"type": ["number", "null"], "minimum": 0},
        "cptk_usd_per_k_tokens": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "runAccounting": {
      "type": "object",
      "required": ["total_billable_tokens", "total_cost_usd", "eval_host_tokens", "eval_host_cost_usd"],
      "properties": {
        "total_billable_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "eval_host_tokens": {"type": ["integer", "null"], "minimum": 0},
        "eval_host_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
